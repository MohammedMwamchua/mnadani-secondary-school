# Copy this file to .env and adjust as needed.

# Generate a real key for production:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# The site refuses to start with DJANGO_DEBUG=False if this is missing.
DJANGO_SECRET_KEY=change-me-to-something-random-before-deploying

# True only on your own computer. Defaults to False if left out, which is
# what production must use (True shows code and settings in error pages).
DJANGO_DEBUG=True

# Your real domain(s) in production, e.g. mnadani.ac.tz,www.mnadani.ac.tz
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# The frontend origin(s) allowed to call this API from the browser.
# In production, your real https:// site address(es) only.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where "View site" / "Return to site" in the admin panel points.
# FRONTEND_URL=https://mnadani.ac.tz/

# ---- Production-only security settings (ignored while DJANGO_DEBUG=True) ----

# Redirects http:// to https://. On by default when DEBUG is False.
# DJANGO_SECURE_SSL_REDIRECT=True

# Set True only if a proxy/CDN (e.g. Cloudflare) sits in front of Django and
# handles HTTPS. If https:// pages redirect to themselves forever, this is why.
# DJANGO_BEHIND_PROXY=False

# HSTS: tells browsers to only ever use HTTPS for your site. Leave at 0 until
# https:// is confirmed working on the live domain — browsers remember this,
# so turning it on while HTTPS is broken locks visitors out for its duration.
# Then start with 3600 (1 hour), and once stable, raise to 31536000 (1 year).
# DJANGO_SECURE_HSTS_SECONDS=0

# Optional: move the admin panel off the default /admin/ address.
# DJANGO_ADMIN_URL=admin

# Optional: store the SQLite database somewhere other than backend/db.sqlite3,
# e.g. outside the web-served folder on your host.
# SQLITE_PATH=/home/youruser/data/db.sqlite3

# Leave DB_ENGINE unset (or anything other than "postgres") to use SQLite —
# zero config, a db.sqlite3 file appears automatically. To use PostgreSQL
# instead, set DB_ENGINE=postgres and fill in the rest:
# DB_ENGINE=postgres
# DB_NAME=mnadani
# DB_USER=mnadani_user
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
